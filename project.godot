; Engine configuration file.
; Memoirs of Technoir — Godot 4 prototype (Compatibility / Web + Android)

config_version=5

[application]

config/name="Memoirs of Technoir"
config/description="Soft story-driven mechanic learning game. Indonesian-first."
config/version="0.1.0"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.3", "4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.svg"

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
Save="*res://scripts/autoload/Save.gd"
ContentDB="*res://scripts/autoload/ContentDB.gd"
AudioBus="*res://scripts/autoload/AudioBus.gd"

[display]

window/size/viewport_width=412
window/size/viewport_height=917
window/size/window_width_override=412
window/size/window_height_override=917
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[internationalization]

locale/fallback="id"
locale/locale_filter_mode=0
